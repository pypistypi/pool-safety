<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PoolSafety" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <!--
            Цвет надписи на кнопке задаётся явно. Без него Material берёт свой
            и пишет фиолетовым по зелёному: читается плохо и к остальному
            оформлению отношения не имеет.
        -->
        <item name="colorPrimary">@color/level_presence</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSecondary">@color/level_presence</item>
        <item name="colorOnSecondary">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorError">@color/level_alarm</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/background</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/background</item>
    </style>

    <style name="Theme.PoolSafety.Settings" parent="Theme.Material3.Dark">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/level_presence</item>
        <item name="colorOnPrimary">@color/background</item>
        <item name="colorSecondary">@color/level_presence</item>
        <item name="colorOnSecondary">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorError">@color/level_alarm</item>
        <!-- Строка состояния не должна светиться зелёным: зелёный в этой
             системе означает «человек в зоне», и красить им что-то ещё
             значит обесценивать его. -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="colorPrimaryContainer">@color/surface</item>
    </style>
</resources>
